FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-tk binutils xvfb xauth ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install pyinstaller==6.22.3
RUN apt-get update && apt-get install -y --no-install-recommends libpython3.10 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
